# Placeholders only. Do not put real keys here, and do not commit a filled-in .env file.
# Pixel2Prompt never reads this file. Save keys in the side panel Settings.
# They are stored in Chrome local storage on that browser.

# Optional. TypeSafe System One / Jev. Leave empty to skip Jev.
TYPESAFE_API_KEY=

# Required to generate a prompt when the provider is Gemini.
GEMINI_API_KEY=

# Required to generate a prompt when the provider is OpenAI.
OPENAI_API_KEY=
